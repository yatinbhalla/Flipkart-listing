# ─── SECURITY — never commit these ─────────────────────────────────────────────
.env
.env.local
# Browser profiles hold live session cookies — one per storefront, because
# Chromium allows a single instance per profile directory.
data/.browser-profile/
data/.meesho-profile/

# ─── Private business data ─────────────────────────────────────────────────────
# Path configs carry manufacturer/packer addresses, MRPs and selling prices.
# Used SKUs reveal listing volume. Front View images are the seller's product
# photos. All of it stays local.
data/paths/
data/used_skus.json
# ephemeral per-run Front View uploads
data/runs/

# ─── Build output ──────────────────────────────────────────────────────────────
node_modules/
dist/

# Debug screenshots from /api/debug/shot
data/*.png

# Scratch request bodies and DOM dumps from debugging a run. These quote live
# Seller Hub markup, so they stay local.
data/*.json

# Scratch paths for one-off run images
f*.txt

# Per-variant Front View photos. Product images stay local, like data/runs.
data/variant-fronts/
