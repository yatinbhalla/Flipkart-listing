# Copy to .env and fill in.

# Gemini — used to write the description / search keywords / key features.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: pin a model instead of using the built-in fallback chain.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Flipkart Seller Hub login. Only used if the saved browser profile has expired —
# normally you log in once by hand and the persistent profile keeps you signed in.
FLIPKART_EMAIL=
FLIPKART_PASSWORD=

# Port for the API/WebSocket server. Leave it unset unless you need a fixed one:
# unset, the app derives it (PORT + 1 when a host assigns a web port, else 3002), so
# two copies can run side by side. Pinning it stops the second one from starting.
# API_PORT=3002

# Meesho Supplier Panel login. Same rule as the Flipkart pair above: read from the
# environment at call time, never logged or echoed. Meesho supports several seller
# accounts, so this is the default one; per-account credentials can follow the
# pattern MEESHO_EMAIL_<ACCOUNT> if more are needed.
MEESHO_EMAIL=
MEESHO_PASSWORD=

# ── Generated listing images ──────────────────────────────────────────────────
# The front image can be produced from one of a path's real photos instead of being
# made by hand: the model is given the photograph and changes only the setting.
#
# Cloudflare Workers AI runs FLUX.2 [klein], and its free allowance of 10,000
# Neurons a day is roughly 57 images — a whole batch — so it is tried first.
# Create a token with the "Workers AI" permission at
# https://dash.cloudflare.com/profile/api-tokens ; the account id is in the URL of
# your Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI takes over when the free allowance runs out or the result is not faithful
# enough. Uses gpt-image-2.5-sunburst, the editing-precision model. Note that GPT
# Image models may need API Organization Verification in the developer console
# before they can be called at all.
OPENAI_API_KEY=

# Which providers to try, in order. Gemini is supported but left out by default:
# image generation has no free tier on that API (quota limit is literally 0), so it
# only works once billing is enabled on a Google Cloud project. To use it, add
# gemini here — it reuses GEMINI_API_KEY above.
# IMAGE_PROVIDERS=cloudflare,openai
# Cheapest setting by default; raise it if the review grid shows the product losing
# detail. OpenAI accepts low | medium | high | xhigh | max.
# IMAGE_QUALITY=low
